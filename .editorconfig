root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

[*.{xml,md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.gradle.kts]
ij_kotlin_name_shorten_on_default_keyword = false
